# ============================================================================
# Job AI Agent - configuration template
# Copy to .env and fill in the values marked REQUIRED.
# ============================================================================

# Application
APP_NAME=Job AI Agent
APP_VERSION=0.8.0
DEBUG=true
ENVIRONMENT=development

# Database (engine.py rewrites this to sqlite+aiosqlite:// automatically)
DATABASE_URL=sqlite:///./data/jobs.db

# API Settings
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# Streamlit Settings
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ----------------------------------------------------------------------------
# AI / LLM -- used for resume tailoring.
# Groq takes precedence over OpenAI when GROQ_API_KEY is set.
# ----------------------------------------------------------------------------
# REQUIRED (or set OPENAI_API_KEY instead)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# ----------------------------------------------------------------------------
# Telegram delivery. Skipped entirely if these are blank.
# ----------------------------------------------------------------------------
# REQUIRED
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# REQUIRED
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=true

# ----------------------------------------------------------------------------
# Daily automation
# ----------------------------------------------------------------------------
AUTOMATION_ENABLED=true
DELIVERY_HOUR=9
DELIVERY_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata

CLEANUP_ENABLED=true
FETCH_ENABLED=true
SCORING_ENABLED=true
EXPORT_ENABLED=true

# Quality bar for the shortlist. Every job at or above this is delivered
# (there is no top-N cap).
MIN_SCORE_THRESHOLD=60.0
MAX_JOBS_PER_DAY=50

# Job fetching
FETCH_INTERVAL_HOURS=6
MAX_JOBS_PER_RUN=50

# ----------------------------------------------------------------------------
# Playwright browser fallback layer
# ----------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# ----------------------------------------------------------------------------
# Source authentication (all optional)
# ----------------------------------------------------------------------------
WELLFOUND_EMAIL=your_wellfound_email_here
WELLFOUND_PASSWORD=your_wellfound_password_here
WELLFOUND_SESSION_FILE=sessions/wellfound_session.json

# Instahyre is disabled in the orchestrator; these have no effect until it is
# re-enabled along with its one-time login automation.
INSTAHYRE_EMAIL=your_instahyre_email_here
INSTAHYRE_SESSION_FILE=sessions/instahyre_session.json
